{
  "name": "inigo-website",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "clean": "node scripts/clean.cjs",
    "dev": "node scripts/ensure-node-version.cjs && next dev",
    "dev:clean": "npm run clean && node scripts/ensure-node-version.cjs && next dev",
    "dev:turbo": "node scripts/ensure-node-version.cjs && next dev --turbopack",
    "build": "node scripts/ensure-node-version.cjs && next build",
    "build:turbo": "node scripts/ensure-node-version.cjs && next build --turbopack",
    "start": "next start",
    "start:prod": "npm run build && next start",
    "lint": "eslint",
    "test:studio-media": "npx --yes tsx --test src/lib/studio/studioThumbnailLifecycle.test.ts",
    "test:studio-media-replacement": "npx --yes tsx --test src/lib/studio/mediaReplacement.test.ts",
    "test:studio-live-metadata": "npx --yes tsx --test src/lib/studio/liveMetadata.test.ts",
    "test:studio-access": "npx --yes tsx --test src/lib/studio/studioAccess.test.ts",
    "test:studio-challenges": "npx --yes tsx --test src/lib/studio/challengeEditor.test.ts src/lib/studio/studioAccess.test.ts",
    "test:studio-recipes": "npx --yes tsx --test src/lib/studio/recipeEditor.test.ts src/lib/studio/recipeImport.test.ts src/lib/studio/recipeImageRequest.test.ts src/lib/studio/studioAccess.test.ts",
    "test:studio-time-suitability": "npx --yes tsx --test src/lib/studio/timeSuitability.test.ts",
    "test:app-download": "npx --yes tsx --test src/lib/appDownloadRedirect.test.ts",
    "test:open-in-app": "npx --yes tsx --test src/lib/openInApp.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "@tailwindcss/oxide": "^4.2.0",
    "firebase": "^11.10.0",
    "next": "15.5.9",
    "next-intl": "^4.5.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.21",
    "eslint": "^9",
    "eslint-config-next": "15.5.9",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.12",
    "typescript": "^5"
  }
}
